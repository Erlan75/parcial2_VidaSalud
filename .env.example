# ============================================================================
# CONFIGURACIÓN DE ENTORNO - CLÍNICA VIDA SALUD (Local y Cloud Render + Neon)
# ============================================================================

APP_NAME="Clínica Vida Salud"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/La_Paz
APP_URL=https://vidasalud.onrender.com

# Migración automática en arranque de contenedor Docker (Render) si la BD está vacía
AUTO_MIGRATE=true

# ----------------------------------------------------------------------------
# OPCIÓN A: Conexión Directa por URL (Recomendado para Neon.tech + Render)
# Ejemplo: postgresql://neondb_owner:AbC123xyz@ep-cool-sky-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# ----------------------------------------------------------------------------
DATABASE_URL=

# ----------------------------------------------------------------------------
# OPCIÓN B: Variables Individuales PostgreSQL (Local 127.0.0.1 o Neon.tech)
# En local deje DB_SSLMODE vacío; en Neon.tech use DB_SSLMODE=require
# ----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=parcial2_VidaSalud
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=

# ----------------------------------------------------------------------------
# Configuración SMTP Gmail para Recuperación de Contraseña
# ----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=erlan.garcia75@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=erlan.garcia75@gmail.com
MAIL_FROM_NAME="Clínica Vida Salud"
